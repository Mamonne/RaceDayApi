@model RaceDayMvc.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Add category";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="mb-1">Add a category</h1>
        <p class="text-muted mb-4">@ViewData["EventName"]</p>

        <form asp-controller="ManageCategories" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="EventId" />

            <partial name="_CategoryFields" model="Model" />

            <button type="submit" class="btn btn-primary">Add category</button>
            <a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}