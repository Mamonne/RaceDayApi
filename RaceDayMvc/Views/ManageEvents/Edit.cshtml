@model RaceDayMvc.Models.EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="mb-4">Edit event</h1>

        <form asp-controller="ManageEvents" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="EventId" />

            <partial name="_EventFields" model="Model" />

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}