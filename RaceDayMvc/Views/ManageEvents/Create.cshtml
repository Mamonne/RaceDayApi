@model RaceDayMvc.Models.EventFormViewModel
@{
    ViewData["Title"] = "Create event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="mb-4">Create an event</h1>

        <form asp-controller="ManageEvents" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <partial name="_EventFields" model="Model" />

            <button type="submit" class="btn btn-primary">Create event</button>
            <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}